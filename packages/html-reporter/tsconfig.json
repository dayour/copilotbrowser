{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "useUnknownInCatchVariables": false,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@protocol/*": ["../protocol/src/*"],
      "@web/*": ["../web/src/*"],
      "@copilotbrowser/test": ["../CopilotBrowser/test.d.ts"],
      "@copilotbrowser/*": ["../CopilotBrowser/src/*"],
      "@recorder/*": ["../recorder/src/*"],
      "@testIsomorphic/types": ["../CopilotBrowser/src/isomorphic/types"],
      "@testIsomorphic/*": ["../CopilotBrowser/src/utils/isomorphic/*"],
      "copilotbrowser/lib/*": ["../CopilotBrowser/src/*"]
    }
  },
  "include": ["src", "../web/src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
