{
  "compilerOptions": {
    "target": "ES2019",
    "module": "commonjs",
    "lib": ["esnext", "dom", "DOM.Iterable"],
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "paths": {
      /*
        The following two serve different purposes:
         - @foo/* is for importing types only,
         - .../lib/* means require dependency
      */
      "@devtools/*": ["./packages/devtools/src/*"],
      "@html-reporter/*": ["./packages/html-reporter/src/*"],
      "@injected/*": ["./packages/injected/src/*"],
      "@isomorphic/*": ["./packages/CopilotBrowser/src/utils/isomorphic/*"],
      "@protocol/*": ["./packages/protocol/src/*"],
      "@recorder/*": ["./packages/recorder/src/*"],
      "@testIsomorphic/*": ["./packages/CopilotBrowser/src/isomorphic/*"],
      "@trace/*": ["./packages/trace/src/*"],
      "@web/*": ["./packages/web/src/*"],
      "copilotbrowser/lib/*": ["./packages/CopilotBrowser/src/*"],
      "@copilotbrowser/copilotbrowser/lib/*": ["./packages/CopilotBrowser/src/*"],
      "copilotbrowser": ["./packages/CopilotBrowser/index.d.ts"],
      "@copilotbrowser/copilotbrowser": ["./packages/CopilotBrowser/index.d.ts"],
      "copilotbrowser/test": ["./packages/CopilotBrowser/test.d.ts"],
      "@copilotbrowser/test": ["./packages/CopilotBrowser/test.d.ts"],
      "copilotbrowser/test/reporter": ["./packages/CopilotBrowser/types/testReporter.d.ts"],
      "@copilotbrowser/test/reporter": ["./packages/CopilotBrowser/types/testReporter.d.ts"],
      "copilotbrowser/types/*": ["./packages/CopilotBrowser/types/*"],
      "@copilotbrowser/copilotbrowser/test": ["./packages/CopilotBrowser/test.d.ts"],
    },
    "esModuleInterop": true,
    "strict": true,
    "allowJs": false,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "noEmit": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
  },
  "compileOnSave": true,
  "include": ["packages"],
  "exclude": [
    "packages/*/lib",
    "packages/copilotbrowser/",
    "packages/html-reporter/",
    "packages/vscode-extension/",
    "packages/chrome-extension/",
    "packages/electron-app/",
  ]
}
