{
  "name": "copilotbrowser",
  "private": true,
  "version": "2.1.0",
  "description": "A high-level API to automate web browsers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dayour/copilotbrowser.git"
  },
  "homepage": "https://github.com/dayour/copilotbrowser",
  "engines": {
    "node": ">=25.6.1"
  },
  "author": {
    "name": "copilot"
  },
  "license": "Apache-2.0",
  "scripts": {
    "ctest": "copilotbrowser test --config=tests/library/copilotbrowser.config.ts --project=chromium-*",
    "ftest": "copilotbrowser test --config=tests/library/copilotbrowser.config.ts --project=firefox-*",
    "wtest": "copilotbrowser test --config=tests/library/copilotbrowser.config.ts --project=webkit-*",
    "atest": "copilotbrowser test --config=tests/android/copilotbrowser.config.ts",
    "etest": "copilotbrowser test --config=tests/electron/copilotbrowser.config.ts",
    "itest": "copilotbrowser test --config=tests/installation/copilotbrowser.config.ts",
    "stest": "copilotbrowser test --config=tests/stress/copilotbrowser.config.ts",
    "biditest": "copilotbrowser test --config=tests/bidi/copilotbrowser.config.ts",
    "ttest": "node ./tests/copilotbrowser-test/stable-test-runner/node_modules/@copilotbrowser/copilotbrowser/cli test --config=tests/copilotbrowser-test/copilotbrowser.config.ts",
    "ct": "copilotbrowser test tests/components/test-all.spec.js --reporter=list",
    "test": "copilotbrowser test --config=tests/library/copilotbrowser.config.ts",
    "test-mcp": "copilotbrowser test --config=tests/mcp/copilotbrowser.config.ts",
    "ctest-mcp": "copilotbrowser test --config=tests/mcp/copilotbrowser.config.ts --project=chrome",
    "eslint": "eslint --cache",
    "tsc": "tsc -p . && tsc -p packages/html-reporter/",
    "doc": "node utils/doclint/cli.js",
    "lint": "concurrently \"npm run eslint\" \"npm run tsc\" \"npm run doc\" \"npm run check-deps\" \"node utils/generate_channels.js\" \"node utils/generate_types/\" \"npm run lint-tests\" \"npm run test-types\" \"npm run lint-packages\" \"node utils/doclint/linting-code-snippets/cli.js --js-only\"",
    "lint:sequential": "npm run eslint && npm run tsc && npm run doc && npm run check-deps && node utils/generate_channels.js && node utils/generate_types/ && npm run lint-tests && npm run test-types && npm run lint-packages",
    "lint-packages": "node utils/workspace.js --ensure-consistent",
    "lint-tests": "node utils/lint_tests.js",
    "clean": "node utils/build/clean.js",
    "build": "node utils/build/build.js",
    "build:simple": "tsc -p packages/copilotbrowser/tsconfig.json",
    "publish": "node utils/publish.js",
    "publish:dry-run": "node utils/publish.js --dry-run",
    "watch": "node utils/build/build.js --watch --lint",
    "test-types": "node utils/generate_types/ && tsc -p utils/generate_types/test/tsconfig.json && tsc -p ./tests/",
    "roll": "node utils/roll_browser.js",
    "check-deps": "node utils/check_deps.js",
    "build-android-driver": "./utils/build_android_driver.sh",
    "innerloop": "copilotbrowser run-server --reuse-browser",
    "copilotbrowser-cli": "node packages/copilotbrowser/lib/cli/client/program.js",
    "test-copilotbrowser-cli": "copilotbrowser test --config=tests/mcp/copilotbrowser.config.ts --project=chrome cli-",
    "copilotbrowser-cli-readme": "node utils/generate_cli_help.js --readme"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@babel/code-frame": "^8.0.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@lowire/loop": "^0.0.26",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/graphql-schema": "^15.26.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/codemirror": "^5.60.17",
    "@types/formidable": "^3.5.1",
    "@types/mdast": "^4.0.4",
    "@types/minimist": "^1.2.5",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@typescript-eslint/utils": "^8.65.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@zip.js/zip.js": "^2.8.33",
    "chokidar": "^5.0.0",
    "chromium-bidi": "^17.0.2",
    "colors": "^1.4.0",
    "commander": "^15.0.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "diff": "^9.0.0",
    "dotenv": "^17.4.2",
    "electron": "^43.1.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-notice": "^1.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "formidable": "^3.5.4",
    "https-proxy-agent": "^9.1.0",
    "ini": "^6.0.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "mime": "^4.1.0",
    "minimatch": "^10.2.5",
    "node-stream-zip": "^1.15.0",
    "open": "^11.0.0",
    "pngjs": "^7.0.0",
    "proxy-from-env": "^2.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rollup": "^4.62.2",
    "sharp": "^0.35.3",
    "socks-proxy-agent": "^10.1.0",
    "ssim.js": "^3.5.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "ws": "^8.21.1",
    "xml2js": "^0.6.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react-hooks": {
      "eslint": "$eslint"
    },
    "glob": "^13.0.5",
    "boolean": "npm:empty-module@0.0.2"
  }
}
